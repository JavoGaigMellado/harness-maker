.venv/
__pycache__/
*.pyc
.env
*.egg-info/
.DS_Store
.pytest_cache/
# Cuál es el recorrido activo es local a cada copia: si viajara por git, quien clona
# heredaría el recorrido de otro proyecto, que es justo lo que el puntero evita.
.harness-maker.json
# Y el recorrido en sí tampoco viaja: las decisiones de cada persona se quedan en su
# copia. La doctrina y los comandos son iguales para todos; el trabajo, no.
/mi-harness/
/mi-harness-anterior-*/
# Abrir el mapa deja un `debug.log` de Chromium en la raíz: lo escribe el navegador,
# no el taller. Sin esta línea, mirar el diagrama ensucia el árbol de cualquiera y
# `publicar.py` se planta antes de publicar, que es donde apareció el 2026-08-11.
/debug.log
