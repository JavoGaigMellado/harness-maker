{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-lab.local/schema/anatomia-2.0.0.json",
  "title": "Doctrina canónica del taller",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "doctrina_version", "metadatos", "centro", "anillos", "categorias", "prioridades", "reglas_globales", "areas_globales", "piezas"],
  "properties": {
    "schema_version": {"const": "2.0.0"}, "doctrina_version": {"type": "string"},
    "metadatos": {"type": "object", "required": ["titulo", "descripcion_producto", "limitacion_evidencia", "fuentes_historicas", "generados", "ejemplo_hilo"], "additionalProperties": true},
    "centro": {"type": "object", "required": ["nombre", "resumen", "ejemplo", "principios", "resumen_html", "industria", "casos", "limitacion_evidencia"], "additionalProperties": true},
    "anillos": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "required": ["id", "nombre", "pregunta", "radio", "descripcion", "descripcion_html", "ejemplo", "puntos_clave"], "additionalProperties": false, "properties": {"id": {"type": "integer", "minimum": 1, "maximum": 4}, "nombre": {"type": "string"}, "pregunta": {"type": "string"}, "radio": {"type": "number"}, "descripcion": {"type": "string"}, "descripcion_html": {"type": "string"}, "ejemplo": {"type": "string"}, "puntos_clave": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
    "categorias": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "required": ["nombre", "prioridad_equivalente", "orden"], "additionalProperties": false, "properties": {"nombre": {"type": "string"}, "prioridad_equivalente": {"enum": ["obligatoria", "alta", "media", "baja", "descartar"]}, "orden": {"type": "integer"}}}},
    "prioridades": {"type": "object", "additionalProperties": {"type": "object", "required": ["orden", "nombre"], "additionalProperties": false, "properties": {"orden": {"type": "integer"}, "nombre": {"type": "string"}}}},
    "reglas_globales": {"type": "array", "items": {"$ref": "#/$defs/regla"}},
    "areas_globales": {"type": "array", "items": {"type": "object", "required": ["id", "etapa", "preguntas", "criterio_cierre"], "additionalProperties": true}},
    "piezas": {"type": "array", "minItems": 18, "maxItems": 18, "items": {"$ref": "#/$defs/pieza"}}
  },
  "$defs": {
    "regla": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "condicion", "prioridad", "porque", "procedencia"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"}, "condicion": {"type": "object"}, "prioridad": {"enum": ["obligatoria", "alta", "media", "baja", "descartar"]}, "porque": {"type": "string", "minLength": 1}, "procedencia": {"type": "string", "minLength": 1}}
    },
    "pieza": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "nombre", "resumen", "anillo", "angulo", "icono", "categoria", "tipo", "dominio", "transversal", "pregunta_principal", "explicacion", "descripcion_html", "ejemplo", "puntos_clave", "que_montar", "industria", "casos", "prioridad_base", "reglas_aplicabilidad", "reglas_prioridad", "dependencias", "desbloquea", "preguntas_diagnostico", "preguntas_recorrido", "criterio_cierre", "evidencias_aceptadas", "artefactos_sugeridos", "condiciones_descarte", "riesgos_omision", "referencias"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"}, "nombre": {"type": "string"}, "resumen": {"type": "string"},
        "categoria": {"type": "string", "pattern": "^c[1-9]$"},
        "descripcion_html": {"type": "string", "minLength": 1},
        "puntos_clave": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "que_montar": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "industria": {"type": "string", "minLength": 1}, "casos": {"type": "string", "minLength": 1},
        "accion_preparada": {"type": "object", "required": ["titulo", "hace", "evidencia", "confirmar_antes"], "additionalProperties": false, "properties": {"titulo": {"type": "string"}, "hace": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "evidencia": {"type": "string"}, "confirmar_antes": {"type": "boolean"}}},
        "anillo": {"type": "integer", "minimum": 1, "maximum": 4}, "angulo": {"type": "number", "minimum": 0, "exclusiveMaximum": 360}, "icono": {"type": "string"},
        "tipo": {"enum": ["componente", "politica", "metrica", "decision"]},
        "dominio": {"enum": ["proposito_gobierno", "contexto_contrato", "flujo_agencia", "calidad_operacion", "harness_desarrollo"]},
        "transversal": {"type": "boolean"}, "pregunta_principal": {"type": "string"}, "explicacion": {"type": "string"}, "ejemplo": {"type": "string"},
        "prioridad_base": {"enum": ["obligatoria", "alta", "media", "baja", "descartar"]},
        "reglas_aplicabilidad": {"type": "array", "items": {"$ref": "#/$defs/regla"}}, "reglas_prioridad": {"type": "array", "items": {"$ref": "#/$defs/regla"}},
        "dependencias": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "desbloquea": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "preguntas_diagnostico": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "preguntas_recorrido": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "criterio_cierre": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "evidencias_aceptadas": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "artefactos_sugeridos": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "condiciones_descarte": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "riesgos_omision": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "referencias": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["tipo_evidencia", "calidad", "procedencia", "referencia"], "additionalProperties": false, "properties": {"tipo_evidencia": {"enum": ["evidencia_interna_n4", "observacion_anecdotica", "recomendacion", "estandar_externo", "prediccion", "resultado_medido"]}, "calidad": {"enum": ["alta", "media", "baja", "no_verificada"]}, "procedencia": {"type": "string"}, "referencia": {"type": "string"}}}
      }
    }
  }
}
}
